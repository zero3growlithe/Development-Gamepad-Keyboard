<Application x:Class="GamepadKeyboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#E0141418" />
        <SolidColorBrush x:Key="KeyBrush" Color="#FF2A2A33" />
        <SolidColorBrush x:Key="KeyBorderBrush" Color="#FF555566" />
        <SolidColorBrush x:Key="HighlightBrush" Color="#FF34D5FF" />
        <SolidColorBrush x:Key="ActiveBrush" Color="#FFFFB03A" />
        <SolidColorBrush x:Key="RayBrush" Color="#8834D5FF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FFF0F0F5" />
        <SolidColorBrush x:Key="DimTextBrush" Color="#FF9090A0" />
    </Application.Resources>
</Application>