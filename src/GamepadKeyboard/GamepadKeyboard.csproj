<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The app.manifest is the DPI source of truth (WPF reads it directly;
         the WinForms bootstrap that ApplicationHighDpiMode feeds is never
         called by the WPF-generated Main). WFAC010 is a mixed-WinForms/WPF
         false positive → suppressed instead of dropping manifest DPI. -->
    <NoWarn>$(NoWarn);WFAC010</NoWarn>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>appicon.ico</ApplicationIcon>
    <AssemblyName>DevelopmentGamepadKeyboard</AssemblyName>
    <RootNamespace>GamepadKeyboard</RootNamespace>
    <Nullable>enable</Nullable>
    <LangVersion>12</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ImplicitUsings>disable</ImplicitUsings>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Version>0.2.0</Version>
    <AssemblyTitle>Development Gamepad Keyboard</AssemblyTitle>
    <Product>Development Gamepad Keyboard</Product>
    <Description>Control the mouse and type with dual analog sticks on gamepads.</Description>
  </PropertyGroup>

  <!-- Build fingerprint for crash.log ("build: <sha>") — GITHUB_SHA is set only on CI builds. -->
  <Target Name="WriteBuildInfo" AfterTargets="PrepareForBuild">
    <WriteLinesToFile File="$(IntermediateOutputPath)BuildInfo.g.cs"
                      Lines="namespace GamepadKeyboard { internal static class BuildInfo { public const string Sha = &quot;$(GITHUB_SHA)&quot;%3B } }"
                      Overwrite="true" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)BuildInfo.g.cs" />
    </ItemGroup>
  </Target>

</Project>